# Required for docker-compose — Postgres credential shared by postgres/api/worker.
# scripts/setup_vastai.sh generates this for you if .env doesn't exist yet.
POSTGRES_PASSWORD=

# Public address Caddy (docker-compose "caddy" service) serves on.
#   - Leave as :80 for plain HTTP on the box's IP — works immediately, no
#     domain needed (e.g. http://<vast.ai-public-ip>).
#   - Set to a real domain (e.g. tungocr.com) once its DNS A record points at
#     this machine's public IP, and Caddy automatically gets a Let's Encrypt
#     HTTPS cert for it on the next `docker compose up`.
SITE_ADDRESS=:80

# Runtime model selection: auto uses AWQ/vLLM when its artifact exists, otherwise HF + LoRA.
INFERENCE_BACKEND=auto
BASE_MODEL_ID=Qwen/Qwen2.5-VL-3B-Instruct

# Optional overrides for mounted local artifacts in Docker.
LORA_ADAPTER_PATH=/app/models/qwen-lora-invoice-adapter-v2
MERGED_MODEL_PATH=/app/models/qwen-merged-invoice-v2
AWQ_MODEL_PATH=/app/models/qwen-awq-invoice-v2
